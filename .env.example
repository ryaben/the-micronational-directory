VITE_FIREBASE_TOKEN=x
VITE_MAPBOX_TOKEN=x
VITE_RECAPTCHA_SITEKEY=x

# Server-side Vercel environment variable (do not prefix with VITE_)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
# Optional: use a key from a separate Groq project to meter AI-filter usage separately.
AI_FILTER_GROQ_API_KEY=your-ai-filter-groq-api-key
# Server-only PAT with Actions, Issues and Contents write permissions. Never prefix with VITE_.
GITHUB_WORKFLOW_TOKEN=your-github-token
